;;;; sb-sprof of the reader over corpus/eclector-reader.txt (8 s after 1 s warm-up).
;;;;   WHICH=base|cst  MODE=cpu|alloc  [GRAPH=1]  sbcl --noinform --non-interactive --no-userinit --load bench/profile.lisp
;;;; Loads Eclector from ~/repos/cl/cl-emacs/Eclector (the checkout this file is in).
(require :asdf)
(require :sb-sprof)
(load "~/quicklisp/setup.lisp")
(push #p"/home/arthur/repos/cl/cl-emacs/Eclector/" asdf:*central-registry*)
(push #p"/home/arthur/repos/cl/Concrete-Syntax-Tree/" asdf:*central-registry*)
(handler-bind ((warning #'muffle-warning))
  (let ((*standard-output* (make-broadcast-stream)) (*error-output* (make-broadcast-stream)))
    (asdf:load-system :eclector) (asdf:load-system :eclector-concrete-syntax-tree)))
(defpackage :scratch (:use :cl))
(defparameter *src*
  (coerce (with-open-file (in "/home/arthur/repos/cl/cl-emacs/Eclector/bench/corpus/eclector-reader.txt")
            (let* ((s (make-string (file-length in))) (n (read-sequence s in))) (subseq s 0 n)))
          'simple-string))
(defun pass (reader)
  (let ((*package* (find-package :scratch)) (start 0) (eof '#:eof))
    (loop (multiple-value-bind (o i) (funcall reader *src* nil eof :start start)
            (when (eq o eof) (return))
            (setf start i)))))
(defun run (reader secs)
  (let ((end (+ (get-internal-real-time) (* secs internal-time-units-per-second))))
    (loop while (< (get-internal-real-time) end) do (pass reader))))
(let ((which (sb-ext:posix-getenv "WHICH")) (mode (intern (string-upcase (sb-ext:posix-getenv "MODE")) :keyword)))
  (let ((reader (if (equal which "cst") #'eclector.concrete-syntax-tree:read-from-string #'eclector.reader:read-from-string)))
    (run reader 1)
    (sb-sprof:with-profiling (:max-samples 100000 :mode mode :sample-interval 0.001)
      (run reader 8))
    (sb-sprof:report :type (if (equal (sb-ext:posix-getenv "GRAPH") "1") :graph :flat) :max 60)))
